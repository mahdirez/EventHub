// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RsvpStatus {
  going
  maybe
  not_going
}

enum EventVisibility {
  private
  public
}

model Category {
  slug      String @id
  sortOrder Int    @default(0) @map("sort_order")

  events Event[]

  @@map("categories")
}

model Event {
  id            String           @id @default(uuid()) @db.Uuid
  ownerUserId   String           @map("owner_user_id")
  title         String
  description   String?
  location      String?
  city          String?
  eventDate     DateTime?        @map("event_date") @db.Timestamptz(6)
  capacity      Int?             @map("capacity")
  visibility    EventVisibility  @default(private)
  categorySlug  String?          @map("category_slug")
  coverImageUrl String?          @map("cover_image_url")
  slug          String?          @unique
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category  Category?       @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  invites   EventInvite?
  rsvps     EventRsvp[]
  favorites EventFavorite[]

  @@index([ownerUserId, createdAt(sort: Desc)], map: "idx_events_owner")
  @@index([visibility, eventDate(sort: Desc)], map: "idx_events_discovery")
  @@index([categorySlug], map: "idx_events_category")
  @@map("events")
}

model EventFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  eventId   String   @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, createdAt(sort: Desc)], map: "idx_favorites_user")
  @@map("event_favorites")
}

model EventInvite {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid
  token   String @unique

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvps EventRsvp[]
  @@map("event_invites")
}

model EventRsvp {
  id              String     @id @default(uuid()) @db.Uuid
  eventId         String     @map("event_id") @db.Uuid
  inviteId        String?    @map("invite_id") @db.Uuid
  name            String
  email           String
  emailNormalized String     @map("email_normalized")
  status          RsvpStatus
  respondedAt     DateTime   @default(now()) @map("responded_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invite EventInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@unique([eventId, emailNormalized])
  @@index([eventId, respondedAt(sort: Desc)], map: "idx_rsvps_event")
  @@map("event_rsvps")
}
